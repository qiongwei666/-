# ===== 应用 =====
APP_NAME=品寻 · 推荐电商平台
APP_ENV=development
DEBUG=true

# ===== JWT =====
# 生产环境请替换为随机长字符串
SECRET_KEY=ecommerce-rec-demo-secret-key-change-me
ALGORITHM=HS256
# 令牌有效期（分钟），默认 7 天
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ===== MySQL 8 =====
# 使用 docker compose 时账号密码与 docker-compose.yml 保持一致
DATABASE_URL=mysql+pymysql://root:276367@127.0.0.1:3306/ecommerce?charset=utf8mb4
DATABASE_ECHO=false

# ===== Redis 7 =====
REDIS_URL=redis://127.0.0.1:6379/0
# 推荐接口要求 1 秒内返回，因此使用较短超时快速降级
REDIS_CONNECT_TIMEOUT=0.25
REDIS_SOCKET_TIMEOUT=0.35

# ===== CORS =====
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
